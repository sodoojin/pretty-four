DB_NAME=pretty_four
DB_USER=pretty_four
DB_PASSWORD=pretty_four_pw
# DB 서버·논리 DB는 ../sprout-infra 가 소유(공유 MariaDB). 로컬 npm 실행 시 DB_HOST=127.0.0.1

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

KAKAO_REST_API_KEY=your-kakao-rest-api-key

APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# production 으로 두면 TypeORM synchronize 꺼지고 마이그레이션 자동 적용(migrationsRun).
# 개발 중에는 비워두거나 development 로 (synchronize 켜짐)
NODE_ENV=development

# CORS 허용 도메인 (콤마 구분). 비워두면 '*' (모든 origin 허용)
# 예: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
