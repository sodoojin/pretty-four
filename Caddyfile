{
	# Cloudflare가 HTTPS 종료를 담당하므로 Caddy는 그냥 HTTP 라우터로만 사용
	auto_https off
}

:3000 {
	reverse_proxy backend-blue:3000 backend-green:3000 {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms

		health_uri /health
		health_interval 5s
		health_timeout 2s
		health_status 2xx
		fail_duration 10s
	}
}
